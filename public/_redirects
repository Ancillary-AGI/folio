# SPA fallback for Netlify and Cloudflare Pages.
# Static files (including hashed /assets/*) are served first; only unknown
# paths reach these rules. Folio routes are client-side History-API paths.
#
# The operator console is a separate document, not a workbench route: /admin
# must reach admin.html so a designer's bundle never contains it. These rules
# are ordered — the first match wins. Where the rule is a document, the
# document is served with the path preserved; the app then canonicalises.

# The workbench's sibling documents.
/admin /admin.html 200
/admin/ /admin.html 200
/console /console.html 200
/console/ /console.html 200
/pricing /pricing.html 200
/pricing/ /pricing.html 200
/landing /landing.html 200
/landing/ /landing.html 200

# The site root is the marketing page, not the workbench.
/ /landing.html 200

# The workbench lives under /app.
/app /index.html 200
/app/* /index.html 200

# Legacy un-prefixed bookmarks from the pre-clean-URL app: the app shell
# canonicalises them to /app/* on boot (see stores/routing.ts).
/projects /index.html 200
/projects/* /index.html 200
/community /index.html 200
/simulation /index.html 200
/control /index.html 200
/machines /index.html 200
