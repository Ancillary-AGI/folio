{
  "name": "folio",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Folio - multi-domain engineering workbench for circuits, PCB, mechanical, robotics and RF design",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev -p 5174",
    "build": "next build",
    "start": "next start -p 5174",
    "preview": "next start -p 5174",
    "lint": "eslint . --max-warnings 0",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "db:start": "npx --yes supabase start",
    "db:reset": "npx --yes supabase db reset",
    "db:push": "npx --yes supabase db push",
    "db:new": "npx --yes supabase migration new",
    "backend": "tsx server/index.ts",
    "backend:db": "tsx server/setup-database.ts",
    "backend:check": "tsx server/selfcheck.ts",
    "backend:reset": "tsx server/reset-db.ts",
    "backend:promote": "tsx server/promote-user.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.57.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "konva": "^9.2.0",
    "lucide-react": "^0.344.0",
    "next": "^14.2.35",
    "nodemailer": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "reactflow": "^11.11.4",
    "recharts": "^2.10.3",
    "tailwind-merge": "^2.2.0",
    "three": "^0.180.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@webgpu/types": "^0.1.74",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^27.0.1",
    "pg": "^8.23.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
