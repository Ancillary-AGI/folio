# Supabase Configuration (optional — the app is fully local without it)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Always-on cloud agents (optional — local design, simulation and autopilot
# work without these). Requires a deployed runner implementing
# docs/AGENT_CLOUD.md. Never put a long-lived service credential in VITE_*:
# every VITE_ value ships in the public bundle.
# VITE_AGENT_CLOUD_URL=https://agents.example.com
# VITE_AGENT_CLOUD_TOKEN=short-lived-token-minted-by-your-backend
