# Supabase Configuration (optional — the app is fully local without it)
# Inlined for the browser at build time. The offline build runs with no
# server at all. A deployment migrated from the Vite build may set the old
# VITE_* names instead — they are honoured as aliases.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# CAPTCHA (optional — public forms are unchallenged without it)
# The newsletter subscribe strip and account signup are public writes, so they
# carry a token from a CAPTCHA provider and the server checks it. Cloudflare
# Turnstile is the default; set CAPTCHA_PROVIDER to hcaptcha or recaptcha to
# switch. The site key is public; the secret is server-only and must never be
# prefixed NEXT_PUBLIC_.
#
# With no site key the widget is omitted. The newsletter route still accepts
# the write, so set both if you run a public deployment.
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_turnstile_site_key
# CAPTCHA_SECRET_KEY=your_turnstile_secret_key
# CAPTCHA_PROVIDER=turnstile

# Always-on cloud agents (optional — local design, simulation and autopilot
# work without these). No external runner is needed: this app ships one under
# /api/v1/agent. Set the URL below to /api to use it (the panel then exchanges
# the signed-in Supabase session for a short-lived runner token). To point at
# a separate compatible runner instead, use its absolute https URL with no
# trailing slash.
# NEXT_PUBLIC_AGENT_CLOUD_URL=/api
#
# A static token is only for an external runner that does not mint per-user
# tokens. It is inlined into the public bundle, so it must be short-lived and
# scoped — never a service credential.
# NEXT_PUBLIC_AGENT_CLOUD_TOKEN=short-lived-token-minted-by-your-backend

# Built-in agent runner (server only — never exposed to the browser bundle).
# Leave all of these unset to keep the runner switched off; the app then reports
# "cloud agents unavailable" and local autopilot keeps working.
#
# Single-tenant self-hosted install: trust same-origin requests carrying the
# x-folio-runner header (cross-site forms cannot set it).
# FOLIO_AGENT_RUNNER_ENABLED=1
# FOLIO_AGENT_RUNNER_TRUST_SAME_ORIGIN=1
#
# Shared deployment key (machine-to-machine or one operator). Every holder can
# see every job, so it is not the multi-tenant mode.
# FOLIO_AGENT_RUNNER_KEY=change-me
#
# Multi-tenant mode: sign per-user tokens. /api/v1/agent/token verifies the
# caller's Supabase session (configured above), then mints a short-lived token
# with this secret. Set both the Supabase values above and this one.
# FOLIO_AGENT_RUNNER_SECRET=change-me-to-a-long-random-value
#
# Queue tuning. Defaults: 1 concurrent job, 15-minute hard wall clock, 2,000
# events retained per job, data under ./.folio-agent/jobs.json.
# FOLIO_AGENT_RUNNER_CONCURRENCY=1
# FOLIO_AGENT_RUNNER_MAX_WALL_MS=900000
# FOLIO_AGENT_RUNNER_MAX_EVENTS=2000
# FOLIO_AGENT_RUNNER_DATA=./.folio-agent

# Newsletter transport (server only). The built-in backend drains campaigns
# through SMTP. Both HOST and FROM must be set before the admin console reports
# the transport as configured; there is no built-in sender identity.
# FOLIO_SMTP_HOST=smtp.example.com
# FOLIO_SMTP_PORT=465
# FOLIO_SMTP_SECURE=true
# FOLIO_SMTP_USER=newsletter@example.com
# FOLIO_SMTP_PASS=your_smtp_password
# FOLIO_SMTP_FROM="Example <newsletter@example.com>"
